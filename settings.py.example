    'house_list': '//*[@id="content"]/div/div[@class="list-item"]',
    'name': './/p[@class="title"]/a/text()',
    'price': './/span[@class="price"]/em/text()',
    'district': './/p[@class="des"]/a[1]/text()',
    'street': './/p[@class="des"]/a[2]/text()',
    'community': './/p[@class="des"]/a[3]/text()',
    'layout': './/p[@class="des"]/text()[1]',
    'square': './/p[@class="des"]/text()[2]',
    'direction': './/p[@class="des"]/text()[3]',
}

